---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";


const articles = await getCollection("articles");
const rankings = await getCollection("rankings");


const categories = [
  ...new Set([
    ...articles.map(item => item.data.category),
    ...rankings.map(item => item.data.category)
  ])
];


const icons: Record<string, string> = {
  "Inteligencia Artificial": "🤖",
  "Tecnología": "💻",
  "Productividad": "⚡",
  "Gaming": "🎮"
};

---


<Layout title="Categorías | Curioxin">


<section class="mx-auto max-w-7xl px-6 py-20">


<h1 class="text-5xl font-bold">
Categorías
</h1>


<p class="mt-4 text-gray-600">
Explora todo el contenido de Curioxin.
</p>



<div class="mt-12 grid gap-6 md:grid-cols-4">


{
categories.map((category)=>(

<a
href={`/categoria/${
  category
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replaceAll(" ", "-")
}`}
class="rounded-3xl border border-gray-200 p-8 transition hover:-translate-y-1 hover:shadow-xl"
>

<div class="text-4xl">
{icons[category] ?? "📚"}
</div>


<h2 class="mt-5 text-xl font-bold">
{category}
</h2>


<p class="mt-3 text-gray-600">
Explora artículos y rankings sobre {category}.
</p>


</a>

))
}


</div>


</section>


</Layout>