---
export const prerender = true;

import { getCollection } from "astro:content";

import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";


const articles = await getCollection("articles");

const rankings = await getCollection("rankings");



const query = Astro.url.searchParams.get("q") ?? "";

const search = query.toLowerCase().trim();



const articleResults = search

? articles
.filter(article => {

const text = `
${article.data.title}
${article.data.description}
${article.data.category}
`.toLowerCase();


return text.includes(search);

})
.sort(
(a,b)=>
new Date(b.data.date).getTime() -
new Date(a.data.date).getTime()
)

: [];







const rankingResults = search

? rankings
.filter(ranking => {

const text = `
${ranking.data.title}
${ranking.data.description}
${ranking.data.category}
`.toLowerCase();


return text.includes(search);

})
.sort(
(a,b)=>
new Date(b.data.date).getTime() -
new Date(a.data.date).getTime()
)

: [];




const totalResults =
articleResults.length + rankingResults.length;

---



<Layout

title="Buscar | Curioxin"

description="Busca artículos y rankings sobre tecnología en Curioxin."

>



<main class="mx-auto max-w-7xl px-6 py-20">





<section class="max-w-3xl">


<p class="text-sm font-semibold uppercase tracking-widest text-blue-600">

🔎 Buscar en Curioxin

</p>



<h1 class="mt-5 text-5xl font-bold tracking-tight">

Encuentra contenido

</h1>




<p class="mt-5 text-lg text-gray-600">

Busca artículos, rankings y análisis sobre tecnología,
inteligencia artificial y productividad.

</p>



</section>







<form

action="/buscar"

method="GET"

class="mt-10 flex flex-col gap-4 sm:flex-row"


>


<input


type="search"

name="q"

value={query}

placeholder="Buscar tecnología, IA, aplicaciones..."

class="flex-1 rounded-2xl border border-gray-200 px-6 py-4 text-lg outline-none transition focus:border-blue-600"



/>




<button

type="submit"

class="rounded-2xl bg-black px-8 py-4 font-semibold text-white transition hover:bg-blue-600"

>

Buscar

</button>



</form>









{
query && (

<section class="mt-14">


<h2 class="text-3xl font-bold">

Resultados para:

<span class="text-blue-600">

"{query}"

</span>

</h2>



<p class="mt-3 text-gray-500">

{
totalResults > 0
? `${totalResults} resultados encontrados`
: "No encontramos coincidencias"
}

</p>


</section>

)

}









{
articleResults.length > 0 && (


<section class="mt-14">


<div class="mb-8">

<h2 class="text-3xl font-bold">

📄 Artículos

</h2>


<p class="mt-2 text-gray-600">

Análisis y contenido editorial.

</p>


</div>





<div class="grid gap-8 md:grid-cols-3">


{
articleResults.map(article => (


<ArticleCard

slug={article.id}

image={article.data.image}

category={article.data.category}

title={article.data.title}

description={article.data.description}

date={article.data.date}

type="article"

/>


))

}



</div>


</section>


)

}









{
rankingResults.length > 0 && (


<section class="mt-20">


<div class="mb-8">

<h2 class="text-3xl font-bold">

🏆 Rankings

</h2>


<p class="mt-2 text-gray-600">

Comparativas y selecciones de herramientas.

</p>


</div>





<div class="grid gap-8 md:grid-cols-3">


{
rankingResults.map(ranking => (


<ArticleCard

slug={ranking.id}

image={ranking.data.image}

category={ranking.data.category}

title={ranking.data.title}

description={ranking.data.description}

type="ranking"

/>


))

}


</div>


</section>


)

}









{
query && totalResults === 0 && (


<section class="mt-16 rounded-3xl border border-gray-200 p-10 text-center">


<h2 class="text-2xl font-bold">

No encontramos resultados

</h2>


<p class="mt-4 text-gray-600">

Intenta buscar otro término como "IA",
"Samsung", "productividad" o "apps".

</p>


</section>


)

}






{
!query && (

<section class="mt-16 rounded-3xl bg-gray-50 p-10">


<h2 class="text-2xl font-bold">

¿Qué puedes buscar?

</h2>


<div class="mt-6 flex flex-wrap gap-3">


<span class="rounded-full bg-white px-5 py-2 text-sm shadow">

Inteligencia Artificial

</span>


<span class="rounded-full bg-white px-5 py-2 text-sm shadow">

Gadgets

</span>


<span class="rounded-full bg-white px-5 py-2 text-sm shadow">

Productividad

</span>


<span class="rounded-full bg-white px-5 py-2 text-sm shadow">

Gaming

</span>


</div>


</section>


)

}



</main>



</Layout>