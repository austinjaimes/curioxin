---
import { getCollection } from "astro:content";

import Layout from "../layouts/Layout.astro";
import ArticleCard from "../components/ArticleCard.astro";

const articles = (await getCollection("articles")).sort(
  (a, b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
);

const rankings = (await getCollection("rankings")).sort(
  (a, b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
);

const latestArticles = articles.slice(0, 3);
const latestRankings = rankings.slice(0, 3);

const categories = [
  {
    name: "Inteligencia Artificial",
    description:
      "Herramientas, novedades, aplicaciones y formas de aprovechar la IA.",
    icon: "✦",
    slug: "inteligencia-artificial"
  },
  {
    name: "Tecnología",
    description:
      "Celulares, laptops, gadgets, dispositivos y tendencias tecnológicas.",
    icon: "⌁",
    slug: "tecnologia"
  },
  {
    name: "Productividad",
    description:
      "Aplicaciones, herramientas y métodos para trabajar y organizarte mejor.",
    icon: "✓",
    slug: "productividad"
  }
];

const explorePaths = [
  {
    title: "Quiero comprar algo",
    description:
      "Encuentra rankings y comparativas para tomar mejores decisiones antes de comprar tecnología.",
    href: "/rankings",
    label: "Ver rankings"
  },
  {
    title: "Quiero aprender algo",
    description:
      "Descubre explicaciones, análisis y contenido útil sobre tecnología, IA y productividad.",
    href: "/articulos",
    label: "Ver artículos"
  },
  {
    title: "Quiero descubrir herramientas",
    description:
      "Explora aplicaciones, servicios y herramientas digitales que pueden ayudarte en tu día a día.",
    href: "/categorias/productividad",
    label: "Descubrir herramientas"
  }
];

const featuredRanking = latestRankings[0];
const featuredArticle = latestArticles[0];

const otherRankings = latestRankings.slice(1);
const otherArticles = latestArticles.slice(1);
---

<Layout
  title="Explorar | Curioxin"
  description="Explora tecnología, inteligencia artificial, productividad, rankings y análisis seleccionados por Curioxin."
>

  <main class="mx-auto max-w-7xl px-6 py-20">

    <!-- HERO -->

    <section class="max-w-4xl">

      <p class="text-sm font-semibold uppercase tracking-widest text-blue-600">
        Curioxin Explore
      </p>

      <h1 class="mt-5 text-5xl font-bold tracking-tight sm:text-6xl">
        Descubre qué hay en Curioxin
      </h1>

      <p class="mt-6 max-w-3xl text-xl leading-relaxed text-gray-600">
        Explora tecnología, inteligencia artificial y productividad a través
        de rankings, análisis y contenido pensado para ayudarte a descubrir
        qué vale la pena y qué realmente puede ser útil para ti.
      </p>

    </section>


    <!-- ENCUENTRA LO QUE NECESITAS -->

    <section class="mt-20">

      <div class="max-w-3xl">

        <p class="text-sm font-semibold uppercase tracking-widest text-gray-400">
          Empieza aquí
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight">
          ¿Qué estás buscando?
        </h2>

        <p class="mt-3 text-gray-600">
          No tienes que saber exactamente qué buscar. Elige el tipo de
          contenido que necesitas y nosotros te llevamos al lugar correcto.
        </p>

      </div>


      <div class="mt-8 grid gap-6 md:grid-cols-3">

        {
          explorePaths.map(path => (

            <a
              href={path.href}
              class="group rounded-3xl border border-gray-200 p-7 transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
            >

              <h3 class="text-2xl font-bold tracking-tight">
                {path.title}
              </h3>

              <p class="mt-4 leading-relaxed text-gray-600">
                {path.description}
              </p>

              <p class="mt-6 font-semibold text-blue-600 transition group-hover:text-blue-700">
                {path.label} →
              </p>

            </a>

          ))
        }

      </div>

    </section>


    <!-- CATEGORÍAS -->

    <section class="mt-24">

      <div class="max-w-3xl">

        <p class="text-sm font-semibold uppercase tracking-widest text-gray-400">
          Explora por tema
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight">
          Encuentra tu próxima obsesión
        </h2>

        <p class="mt-3 text-gray-600">
          Tres áreas principales reúnen buena parte del contenido de Curioxin.
          Entra en una categoría y descubre todo lo relacionado con ella.
        </p>

      </div>


      <div class="mt-8 grid gap-6 md:grid-cols-3">

        {
          categories.map(category => (

            <a
              href={`/categorias/${category.slug}`}
              class="group rounded-3xl border border-gray-200 p-8 transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
            >

              <div
                class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-xl font-bold text-blue-600"
              >
                {category.icon}
              </div>

              <h3 class="mt-6 text-2xl font-bold tracking-tight">
                {category.name}
              </h3>

              <p class="mt-3 leading-relaxed text-gray-600">
                {category.description}
              </p>

              <p class="mt-6 font-semibold text-blue-600">
                Explorar {category.name} →
              </p>

            </a>

          ))
        }

      </div>

    </section>


    <!-- RANKING DESTACADO -->

    {
      featuredRanking && (

        <section class="mt-24">

          <div class="flex items-end justify-between gap-6">

            <div>

              <p class="text-sm font-semibold uppercase tracking-widest text-gray-400">
                Recomendaciones
              </p>

              <h2 class="mt-3 text-3xl font-bold tracking-tight">
                Un ranking para empezar
              </h2>

            </div>

            <a
              href="/rankings"
              class="hidden font-semibold text-blue-600 hover:text-blue-700 sm:block"
            >
              Ver todos →
            </a>

          </div>


          <a
            href={`/rankings/${featuredRanking.id}`}
            class="group mt-8 block overflow-hidden rounded-3xl border border-gray-200 transition hover:border-blue-200 hover:shadow-xl"
          >

            <div class="grid md:grid-cols-2">

              {
                featuredRanking.data.image && (

                  <div class="aspect-[16/10] overflow-hidden bg-gray-100">

                    <img
                      src={featuredRanking.data.image}
                      alt={featuredRanking.data.title}
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                    />

                  </div>

                )
              }


              <div class="flex flex-col justify-center p-8 md:p-10">

                <p class="text-sm font-semibold text-blue-600">
                  {featuredRanking.data.category}
                </p>

                <h3 class="mt-3 text-3xl font-bold tracking-tight">
                  {featuredRanking.data.title}
                </h3>

                <p class="mt-4 leading-relaxed text-gray-600">
                  {featuredRanking.data.description}
                </p>

                <p class="mt-7 font-semibold text-blue-600">
                  Ver ranking completo →
                </p>

              </div>

            </div>

          </a>


          <a
            href="/rankings"
            class="mt-6 block font-semibold text-blue-600 sm:hidden"
          >
            Ver todos los rankings →
          </a>

        </section>

      )
    }


    <!-- OTROS RANKINGS -->

    {
      otherRankings.length > 0 && (

        <section class="mt-16">

          <div class="grid gap-6 md:grid-cols-2">

            {
              otherRankings.map(ranking => (

                <a
                  href={`/rankings/${ranking.id}`}
                  class="group rounded-3xl border border-gray-200 p-7 transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-lg"
                >

                  <p class="text-sm font-semibold text-blue-600">
                    {ranking.data.category}
                  </p>

                  <h3 class="mt-3 text-2xl font-bold tracking-tight">
                    {ranking.data.title}
                  </h3>

                  <p class="mt-3 leading-relaxed text-gray-600">
                    {ranking.data.description}
                  </p>

                  <p class="mt-5 font-semibold text-blue-600">
                    Ver ranking →
                  </p>

                </a>

              ))
            }

          </div>

        </section>

      )
    }


    <!-- ARTÍCULO DESTACADO -->

    {
      featuredArticle && (

        <section class="mt-24">

          <div class="flex items-end justify-between gap-6">

            <div>

              <p class="text-sm font-semibold uppercase tracking-widest text-gray-400">
                Lecturas recientes
              </p>

              <h2 class="mt-3 text-3xl font-bold tracking-tight">
                Algo interesante para leer
              </h2>

            </div>

            <a
              href="/articulos"
              class="hidden font-semibold text-blue-600 hover:text-blue-700 sm:block"
            >
              Ver todos →
            </a>

          </div>


          <div class="mt-8">

            <ArticleCard
              slug={featuredArticle.id}
              image={featuredArticle.data.image}
              category={featuredArticle.data.category}
              title={featuredArticle.data.title}
              description={featuredArticle.data.description}
              date={featuredArticle.data.date}
              type="article"
            />

          </div>


          <a
            href="/articulos"
            class="mt-6 block font-semibold text-blue-600 sm:hidden"
          >
            Ver todos los artículos →
          </a>

        </section>

      )
    }


    <!-- OTROS ARTÍCULOS -->

    {
      otherArticles.length > 0 && (

        <section class="mt-16">

          <div class="grid gap-8 md:grid-cols-2">

            {
              otherArticles.map(article => (

                <ArticleCard
                  slug={article.id}
                  image={article.data.image}
                  category={article.data.category}
                  title={article.data.title}
                  description={article.data.description}
                  date={article.data.date}
                  type="article"
                />

              ))
            }

          </div>

        </section>

      )
    }


    <!-- CIERRE -->

    <section class="mt-24 rounded-3xl bg-gray-950 px-8 py-14 text-white md:px-12">

      <div class="max-w-3xl">

        <p class="text-sm font-semibold uppercase tracking-widest text-blue-400">
          Sigue explorando
        </p>

        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          Curioxin está hecho para ayudarte a descubrir qué vale la pena.
        </h2>

        <p class="mt-5 text-lg leading-relaxed text-gray-300">
          Desde una herramienta de inteligencia artificial hasta el próximo
          dispositivo que quieres comprar, explora nuestras comparativas,
          análisis y recomendaciones para tomar mejores decisiones.
        </p>


        <div class="mt-8 flex flex-col gap-4 sm:flex-row">

          <a
            href="/rankings"
            class="rounded-2xl bg-white px-6 py-3 text-center font-semibold text-gray-950 transition hover:bg-blue-50"
          >
            Explorar rankings
          </a>

          <a
            href="/articulos"
            class="rounded-2xl border border-gray-700 px-6 py-3 text-center font-semibold transition hover:border-gray-500"
          >
            Leer artículos
          </a>

        </div>

      </div>

    </section>

  </main>

</Layout>