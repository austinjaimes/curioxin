---
import Layout from "../layouts/Layout.astro";


const categories = [

{
name: "Inteligencia Artificial",
slug: "inteligencia-artificial",
description:
"Herramientas, noticias y análisis sobre inteligencia artificial."
},


{
name: "Tecnología",
slug: "tecnologia",
description:
"Dispositivos, aplicaciones y tendencias tecnológicas."
},


{
name: "Productividad",
slug: "productividad",
description:
"Herramientas y métodos para mejorar tu productividad."
}

];

---


<Layout

title="Categorías | Curioxin"

description="Explora todas las categorías de Curioxin."

>


<main class="mx-auto max-w-7xl px-6 py-20">


<section class="max-w-3xl">


<p class="text-sm font-semibold text-blue-600">
Explorar
</p>


<h1 class="mt-4 text-5xl font-bold">
Categorías
</h1>


<p class="mt-5 text-lg text-gray-600">
Encuentra contenido organizado por temas.
</p>


</section>





<section class="mt-14 grid gap-8 md:grid-cols-3">


{
categories.map(category => (

<a

href={`/categoria/${category.slug}`}

class="rounded-3xl border border-gray-200 p-8 transition hover:-translate-y-1 hover:shadow-xl"

>


<h2 class="text-2xl font-bold">

{category.name}

</h2>



<p class="mt-4 text-gray-600">

{category.description}

</p>



<div class="mt-6 font-medium">

Ver artículos →

</div>


</a>


))
}


</section>


</main>


</Layout>