---
import Layout from "../layouts/Layout.astro";
---

<Layout
title="Página no encontrada | Curioxin"
description="La página que buscas no existe."
>

<main class="mx-auto flex min-h-[70vh] max-w-3xl flex-col items-center justify-center px-6 text-center">

<p class="text-8xl font-bold text-blue-600">
404
</p>

<h1 class="mt-6 text-5xl font-bold">
Página no encontrada
</h1>

<p class="mt-6 text-lg text-gray-600">
Parece que el contenido que buscas ya no existe
o la dirección es incorrecta.
</p>

<div class="mt-10 flex flex-wrap justify-center gap-4">

<a
href="/"
class="rounded-full bg-black px-6 py-3 text-white transition hover:bg-blue-600"
>
Volver al inicio
</a>

<a
href="/explorar"
class="rounded-full border border-gray-300 px-6 py-3 transition hover:border-blue-600 hover:text-blue-600"
>
Explorar Curioxin
</a>

</div>

</main>

</Layout>