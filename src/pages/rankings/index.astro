---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../utils/formatDate";

const rankings = (await getCollection("rankings"))
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() -
      new Date(a.data.date).getTime()
  );

const categories = [
  ...new Set(
    rankings.map(ranking => ranking.data.category)
  )
];

const shoppingGuides = [
  {
    name: "Celulares",
    description:
      "Qué revisar antes de comprar un celular y cómo elegir según tu presupuesto y necesidades.",
    href: "/compras-inteligentes/celulares"
  },
  {
    name: "Audífonos Bluetooth",
    description:
      "Aprende qué características realmente importan antes de comprar audífonos Bluetooth.",
    href: "/compras-inteligentes/audifonos-bluetooth"
  },
  {
    name: "Laptops",
    description:
      "Una guía para elegir procesador, memoria, almacenamiento y pantalla según tu uso.",
    href: "/compras-inteligentes/laptops"
  },
  {
    name: "Monitores",
    description:
      "Descubre qué resolución, panel, frecuencia y características necesitas.",
    href: "/compras-inteligentes/monitores"
  },
  {
    name: "Smartwatches",
    description:
      "Qué debes considerar antes de elegir un smartwatch para tu día a día.",
    href: "/compras-inteligentes/smartwaches"
  },
  {
    name: "Gaming",
    description:
      "Cómo elegir productos gaming sin gastar de más y qué características importan.",
    href: "/compras-inteligentes/gaming"
  }
];

const getCategorySlug = (category) =>
  category
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replaceAll(" ", "-");

const getCategoryCount = (category) =>
  rankings.filter(
    ranking => ranking.data.category === category
  ).length;
---

<Layout
  title="Rankings | Curioxin"
  description="Los mejores rankings, comparativas y selecciones de tecnología, inteligencia artificial y productividad."
>

  <main class="mx-auto max-w-7xl px-6 py-20">

    <header class="max-w-4xl">

      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
        Curioxin Rankings
      </p>

      <h1 class="mt-5 text-5xl font-bold leading-tight tracking-tight text-gray-950 md:text-6xl">
        Rankings para elegir mejor
      </h1>

      <p class="mt-6 max-w-3xl text-xl leading-relaxed text-gray-600">
        Comparamos productos, herramientas y servicios para ayudarte a
        encontrar las opciones que realmente destacan.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">

        <span class="rounded-full bg-gray-100 px-4 py-2 text-sm font-medium text-gray-600">
          {rankings.length} {rankings.length === 1 ? "ranking" : "rankings"}
        </span>

        {
          categories.map(category => (
            <a
              href={`/categorias/${getCategorySlug(category)}`}
              class="rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-gray-600 transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-600"
            >
              {category} · {getCategoryCount(category)}
            </a>
          ))
        }

      </div>

    </header>


    <!-- Compras inteligentes -->

    <section class="mt-16 rounded-3xl bg-blue-50 px-8 py-10 md:px-12">

      <div class="max-w-3xl">

        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
          Compras inteligentes
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 md:text-4xl">
          ¿No sabes cuál elegir?
        </h2>

        <p class="mt-4 leading-relaxed text-gray-600">
          Nuestros rankings te muestran qué productos destacan, pero si
          quieres entender qué debes revisar antes de comprar, consulta
          nuestras guías de compras inteligentes.
        </p>

        <a
          href="/compras-inteligentes"
          class="mt-7 inline-flex rounded-full bg-black px-6 py-3 font-semibold text-white transition hover:bg-blue-600"
        >
          Explorar compras inteligentes →
        </a>

      </div>

    </section>


    <!-- Rankings -->

    <section class="mt-20">

      <div class="flex flex-col justify-between gap-4 border-b border-gray-200 pb-6 md:flex-row md:items-end">

        <div>

          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
            Comparativas
          </p>

          <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-950">
            Rankings recientes
          </h2>

        </div>

        <p class="text-sm text-gray-500">
          Actualizados por fecha de publicación
        </p>

      </div>


      {
        rankings.length > 0 ? (

          <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">

            {
              rankings.map(ranking => (

                <a
                  href={`/rankings/${ranking.id}`}
                  class="group overflow-hidden rounded-3xl border border-gray-200 bg-white transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-gray-200/50"
                >

                  <div class="relative overflow-hidden">

                    <img
                      src={ranking.data.image}
                      alt={ranking.data.title}
                      loading="lazy"
                      class="h-60 w-full object-cover transition duration-500 group-hover:scale-105"
                    />

                    <div class="absolute left-5 top-5">

                      <span class="rounded-full bg-white/95 px-4 py-2 text-sm font-semibold text-gray-950 shadow-sm backdrop-blur">
                        Ranking
                      </span>

                    </div>

                  </div>


                  <div class="p-7">

                    <p class="text-sm font-semibold text-blue-600">
                      {ranking.data.category}
                    </p>

                    <h2 class="mt-3 text-2xl font-bold leading-tight tracking-tight text-gray-950">
                      {ranking.data.title}
                    </h2>

                    <p class="mt-4 leading-relaxed text-gray-600">
                      {ranking.data.description}
                    </p>

                    <div class="mt-6 flex items-center justify-between">

                      <span class="text-sm text-gray-500">
                        {formatDate(ranking.data.date)}
                      </span>

                      <span class="font-semibold text-gray-950 transition group-hover:text-blue-600">
                        Ver ranking →
                      </span>

                    </div>

                  </div>

                </a>

              ))
            }

          </div>

        ) : (

          <section class="mt-10 rounded-3xl border border-gray-200 p-10 text-center">

            <h2 class="text-2xl font-bold text-gray-950">
              Aún no hay rankings publicados
            </h2>

            <p class="mt-4 text-gray-600">
              Pronto encontrarás nuevas comparativas y selecciones de tecnología.
            </p>

          </section>

        )
      }

    </section>


    <!-- Guías de compras inteligentes -->

    <section class="mt-24">

      <div class="max-w-3xl">

        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
          Guías de compra
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 md:text-4xl">
          Aprende a comprar mejor
        </h2>

        <p class="mt-4 leading-relaxed text-gray-600">
          Antes de elegir un producto, conviene saber qué características
          realmente importan. Explora nuestras guías para tomar decisiones
          más informadas.
        </p>

      </div>


      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">

        {
          shoppingGuides.map(guide => (

            <a
              href={guide.href}
              class="group rounded-3xl border border-gray-200 bg-white p-7 transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-gray-200/50"
            >

              <div class="flex items-center justify-between">

                <span class="text-sm font-semibold uppercase tracking-wider text-blue-600">
                  Guía de compra
                </span>

                <span class="text-xl text-gray-300 transition group-hover:translate-x-1 group-hover:text-blue-600">
                  →
                </span>

              </div>

              <h3 class="mt-8 text-2xl font-bold tracking-tight text-gray-950">
                {guide.name}
              </h3>

              <p class="mt-3 leading-relaxed text-gray-600">
                {guide.description}
              </p>

              <p class="mt-6 font-semibold text-gray-950 transition group-hover:text-blue-600">
                Leer guía →
              </p>

            </a>

          ))
        }

      </div>

    </section>


    <!-- CTA final -->

    <section class="mt-24 rounded-3xl bg-gray-950 px-8 py-10 text-white md:px-12">

      <div class="max-w-2xl">

        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-400">
          Curioxin
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
          Comparar antes de comprar
        </h2>

        <p class="mt-4 leading-relaxed text-gray-400">
          Analizamos productos y herramientas para ayudarte a encontrar
          opciones que realmente tengan sentido según tus necesidades,
          presupuesto y forma de uso.
        </p>

        <a
          href="/compras-inteligentes"
          class="mt-7 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-gray-950 transition hover:bg-blue-600 hover:text-white"
        >
          Ver compras inteligentes
        </a>

      </div>

    </section>

  </main>

</Layout>