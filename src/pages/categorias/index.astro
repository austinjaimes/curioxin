---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";


const articles = await getCollection("articles");
const rankings = await getCollection("rankings");


const categories = [
  ...new Set([
    ...articles.map(item => item.data.category),
    ...rankings.map(item => item.data.category)
  ])
];

---


<Layout

title="Categorías | Curioxin"

description="Explora todas las categorías de Curioxin."

>


<main class="mx-auto max-w-6xl px-6 py-20">


<h1 class="text-5xl font-bold">
Categorías
</h1>



<div class="mt-12 grid gap-6 md:grid-cols-3">


{
categories.map(category => (

<a

href={`/categorias/${category.toLowerCase().replaceAll(" ", "-")}`}

class="rounded-3xl border border-gray-200 p-8 transition hover:-translate-y-1 hover:shadow-xl"

>

<h2 class="text-2xl font-bold">
{category}
</h2>

<p class="mt-3 text-gray-600">
Explorar contenido →
</p>

</a>

))
}


</div>


</main>


</Layout>