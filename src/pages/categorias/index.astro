---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const articles = await getCollection("articles");
const rankings = await getCollection("rankings");

const categories = [
  ...new Set([
    ...articles.map(item => item.data.category),
    ...rankings.map(item => item.data.category)
  ])
];

const categoryDescriptions = {
  "Tecnología":
    "Celulares, laptops, gadgets y productos tecnológicos que vale la pena conocer.",
  "Inteligencia Artificial":
    "Herramientas, aplicaciones y novedades de inteligencia artificial.",
  "Productividad":
    "Aplicaciones y herramientas para estudiar, trabajar y organizar mejor tu día.",
  "Compras inteligentes":
    "Comparativas y recomendaciones para encontrar mejores productos sin gastar de más."
};

const getCategorySlug = (category) =>
  category
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replaceAll(" ", "-");

const getCategoryCount = (category) =>
  articles.filter(item => item.data.category === category).length +
  rankings.filter(item => item.data.category === category).length;
---

<Layout
  title="Categorías | Curioxin"
  description="Explora las categorías de Curioxin y descubre artículos, análisis, comparativas y rankings sobre tecnología."
>

  <main class="mx-auto max-w-7xl px-6 py-20">

    <header class="max-w-3xl">

      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
        Explora Curioxin
      </p>

      <h1 class="mt-4 text-5xl font-bold tracking-tight text-gray-950 md:text-6xl">
        Categorías
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-gray-600">
        Explora nuestros contenidos por categoría y descubre análisis,
        comparativas, rankings y recomendaciones sobre tecnología y herramientas digitales.
      </p>

    </header>


    <section class="mt-16">

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">

        {
          categories.map((category, index) => {

            const count = getCategoryCount(category);
            const description =
              categoryDescriptions[category] ??
              "Descubre artículos, análisis y rankings relacionados con esta categoría.";

            return (

              <a
                href={`/categorias/${getCategorySlug(category)}`}
                class="group relative overflow-hidden rounded-3xl border border-gray-200 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-gray-200/50"
              >

                <div class="flex items-start justify-between">

                  <span class="text-sm font-semibold text-gray-400">
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span class="text-xl text-gray-300 transition-all duration-300 group-hover:translate-x-1 group-hover:text-blue-600">
                    →
                  </span>

                </div>


                <h2 class="mt-12 text-2xl font-bold tracking-tight text-gray-950">
                  {category}
                </h2>


                <p class="mt-3 leading-relaxed text-gray-600">
                  {description}
                </p>


                <div class="mt-8 flex items-center justify-between">

                  <span class="text-sm font-medium text-gray-400">
                    {count} {count === 1 ? "contenido" : "contenidos"}
                  </span>

                  <span class="h-1 w-10 rounded-full bg-blue-600 transition-all duration-300 group-hover:w-20">
                  </span>

                </div>

              </a>

            );

          })
        }

      </div>

    </section>


    <section class="mt-20 rounded-3xl bg-gray-950 px-8 py-10 text-white md:px-12">

      <div class="max-w-2xl">

        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-400">
          Curioxin
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
          Tecnología explicada para ayudarte a decidir mejor
        </h2>

        <p class="mt-4 leading-relaxed text-gray-400">
          Analizamos productos, herramientas y tendencias para que puedas
          encontrar información útil antes de tomar una decisión.
        </p>

      </div>

    </section>

  </main>

</Layout>