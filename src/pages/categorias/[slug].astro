---
export const prerender = true;

import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const rankings = await getCollection("rankings");

  const categories = [
    ...new Set([
      ...articles.map(item => item.data.category),
      ...rankings.map(item => item.data.category)
    ])
  ];

  return categories.map(category => ({
    params: {
      slug: category
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replaceAll(" ", "-")
    },
    props: {
      category
    }
  }));
}

const { category } = Astro.props;

const articles = await getCollection(
  "articles",
  (article) => article.data.category === category
);

const rankings = await getCollection(
  "rankings",
  (ranking) => ranking.data.category === category
);

const totalContent = articles.length + rankings.length;

const categoryDescriptions = {
  "Tecnología":
    "Descubre análisis sobre celulares, laptops, gadgets y las tecnologías que están transformando nuestra vida diaria.",
  "Inteligencia Artificial":
    "Explora herramientas de inteligencia artificial, nuevas aplicaciones y tecnologías que están cambiando la forma de trabajar y crear.",
  "Productividad":
    "Encuentra aplicaciones, métodos y herramientas digitales que pueden ayudarte a estudiar, trabajar y organizar mejor tu tiempo.",
  "Compras inteligentes":
    "Compara productos, descubre recomendaciones y encuentra opciones que ofrecen una buena relación entre precio, calidad y utilidad."
};

const categoryDescription =
  categoryDescriptions[category] ??
  `Descubre artículos, análisis, comparativas y rankings sobre ${category}.`;
---

<Layout
  title={`${category} | Curioxin`}
  description={categoryDescription}
>

  <main class="mx-auto max-w-7xl px-6 py-20">

    <header class="max-w-3xl">

      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
        Categoría
      </p>

      <h1 class="mt-4 text-5xl font-bold tracking-tight text-gray-950 md:text-6xl">
        {category}
      </h1>

      <p class="mt-6 text-lg leading-relaxed text-gray-600">
        {categoryDescription}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">

        <span class="rounded-full bg-gray-100 px-4 py-2 text-sm font-medium text-gray-600">
          {articles.length} {articles.length === 1 ? "artículo" : "artículos"}
        </span>

        <span class="rounded-full bg-gray-100 px-4 py-2 text-sm font-medium text-gray-600">
          {rankings.length} {rankings.length === 1 ? "ranking" : "rankings"}
        </span>

      </div>

    </header>


    <section class="mt-16 rounded-3xl bg-gray-50 p-8 md:p-10">

      <div class="max-w-3xl">

        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
          Sobre esta categoría
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-950">
          Información para ayudarte a elegir mejor
        </h2>

        <p class="mt-4 leading-relaxed text-gray-600">
          En Curioxin reunimos contenido sobre {category} para que puedas
          conocer nuevas opciones, comparar alternativas y entender mejor
          la tecnología que utilizas todos los días.
        </p>

      </div>

    </section>


    {
      rankings.length > 0 && (

        <section class="mt-20">

          <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">

            <div>

              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
                Comparativas
              </p>

              <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-950">
                Rankings de {category}
              </h2>

              <p class="mt-3 max-w-2xl text-gray-600">
                Comparativas y selecciones para encontrar las mejores opciones.
              </p>

            </div>

          </div>


          <div class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-3">

            {
              rankings.map(ranking => (

                <ArticleCard
                  slug={ranking.id}
                  image={ranking.data.image}
                  category={ranking.data.category}
                  title={ranking.data.title}
                  description={ranking.data.description}
                  date={ranking.data.date}
                  type="ranking"
                />

              ))
            }

          </div>

        </section>

      )
    }


    {
      articles.length > 0 && (

        <section class="mt-20">

          <div>

            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
              Contenido
            </p>

            <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-950">
              Últimos artículos
            </h2>

            <p class="mt-3 max-w-2xl text-gray-600">
              Análisis, explicaciones y contenido útil sobre {category}.
            </p>

          </div>


          <div class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-3">

            {
              articles.map(article => (

                <ArticleCard
                  slug={article.id}
                  image={article.data.image}
                  category={article.data.category}
                  title={article.data.title}
                  description={article.data.description}
                  date={article.data.date}
                />

              ))
            }

          </div>

        </section>

      )
    }


    {
      totalContent === 0 && (

        <section class="mt-20 rounded-3xl border border-gray-200 p-10 text-center">

          <h2 class="text-2xl font-bold text-gray-950">
            Próximamente
          </h2>

          <p class="mx-auto mt-3 max-w-xl text-gray-600">
            Estamos preparando nuevo contenido sobre {category}.
          </p>

        </section>

      )
    }


    <section class="mt-20 rounded-3xl bg-gray-950 px-8 py-10 text-white md:px-12">

      <div class="max-w-2xl">

        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-400">
          Curioxin
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
          Descubre más contenido
        </h2>

        <p class="mt-4 leading-relaxed text-gray-400">
          Explora nuestros artículos, rankings y comparativas para encontrar
          información útil antes de tomar una decisión.
        </p>

        <a
          href="/articulos"
          class="mt-7 inline-flex rounded-full bg-white px-6 py-3 font-semibold text-gray-950 transition hover:bg-blue-600 hover:text-white"
        >
          Ver todos los artículos
        </a>

      </div>

    </section>

  </main>

</Layout>