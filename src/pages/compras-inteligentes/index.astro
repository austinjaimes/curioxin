---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const rankings = await getCollection("rankings");
const articles = await getCollection("articles");

const technologyRankings = rankings
  .filter((item) => item.data.category === "Tecnología")
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() -
      new Date(a.data.date).getTime()
  )
  .slice(0, 6);

const technologyArticles = articles
  .filter((item) => item.data.category === "Tecnología")
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() -
      new Date(a.data.date).getTime()
  )
  .slice(0, 6);
---

<Layout
  title="Compras inteligentes | Curioxin"
  description="Guías y recomendaciones para comprar tecnología de forma inteligente, comparar opciones y encontrar productos que realmente valen la pena."
>

  <main class="mx-auto max-w-7xl px-6 py-20">

    <!-- Hero -->

    <section class="max-w-4xl">

      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
        Compras inteligentes
      </p>

      <h1 class="mt-4 text-5xl font-bold tracking-tight text-gray-950 md:text-6xl">
        Compra mejor. No simplemente más caro.
      </h1>

      <p class="mt-6 max-w-3xl text-lg leading-relaxed text-gray-600">
        Elegir tecnología puede ser complicado. Hay cientos de modelos,
        especificaciones que no siempre son fáciles de entender y diferencias
        de precio que no necesariamente significan una mejor experiencia.
      </p>

      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-gray-600">
        En Curioxin analizamos qué características realmente importan para
        ayudarte a encontrar productos que tengan sentido para tu presupuesto
        y la forma en que piensas utilizarlos.
      </p>

    </section>


    <!-- Cómo funciona -->

    <section class="mt-20">

      <div class="max-w-2xl">

        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
          Cómo funciona
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 md:text-4xl">
          Antes de recomendar, primero analizamos
        </h2>

      </div>


      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">

        <article class="rounded-3xl border border-gray-200 bg-white p-7">

          <span class="text-sm font-bold text-blue-600">
            01
          </span>

          <h3 class="mt-5 text-xl font-bold text-gray-950">
            Necesidad
          </h3>

          <p class="mt-3 leading-relaxed text-gray-600">
            Analizamos para qué tipo de usuario tiene sentido cada producto.
          </p>

        </article>


        <article class="rounded-3xl border border-gray-200 bg-white p-7">

          <span class="text-sm font-bold text-blue-600">
            02
          </span>

          <h3 class="mt-5 text-xl font-bold text-gray-950">
            Características
          </h3>

          <p class="mt-3 leading-relaxed text-gray-600">
            Nos enfocamos en las especificaciones que realmente afectan
            la experiencia de uso.
          </p>

        </article>


        <article class="rounded-3xl border border-gray-200 bg-white p-7">

          <span class="text-sm font-bold text-blue-600">
            03
          </span>

          <h3 class="mt-5 text-xl font-bold text-gray-950">
            Precio
          </h3>

          <p class="mt-3 leading-relaxed text-gray-600">
            Comparamos lo que ofrece un producto frente a alternativas
            de diferentes precios.
          </p>

        </article>


        <article class="rounded-3xl border border-gray-200 bg-white p-7">

          <span class="text-sm font-bold text-blue-600">
            04
          </span>

          <h3 class="mt-5 text-xl font-bold text-gray-950">
            Valor real
          </h3>

          <p class="mt-3 leading-relaxed text-gray-600">
            La pregunta final es sencilla: ¿realmente vale lo que cuesta?
          </p>

        </article>

      </div>

    </section>


    <!-- Guías por necesidad -->

    <section class="mt-24">

      <div class="max-w-2xl">

        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
          Encuentra lo que necesitas
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 md:text-4xl">
          ¿Qué estás buscando?
        </h2>

        <p class="mt-4 leading-relaxed text-gray-600">
          No todos necesitan el mismo producto. Empieza por el uso que
          quieres darle y después compara las opciones disponibles.
        </p>

      </div>


      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">

        <a
          href="/rankings"
          class="group rounded-3xl border border-gray-200 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-gray-200/50"
        >

          <span class="text-3xl">📱</span>

          <h3 class="mt-6 text-2xl font-bold text-gray-950">
            Celulares
          </h3>

          <p class="mt-3 leading-relaxed text-gray-600">
            Encuentra smartphones según presupuesto, rendimiento,
            cámara, batería y necesidades.
          </p>

          <span class="mt-6 inline-flex items-center gap-2 font-semibold text-gray-950">
            Ver opciones
            <span class="transition group-hover:translate-x-1">→</span>
          </span>

        </a>


        <a
          href="/rankings"
          class="group rounded-3xl border border-gray-200 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-gray-200/50"
        >

          <span class="text-3xl">🎧</span>

          <h3 class="mt-6 text-2xl font-bold text-gray-950">
            Audífonos
          </h3>

          <p class="mt-3 leading-relaxed text-gray-600">
            Compara sonido, cancelación de ruido, autonomía,
            comodidad y precio.
          </p>

          <span class="mt-6 inline-flex items-center gap-2 font-semibold text-gray-950">
            Ver opciones
            <span class="transition group-hover:translate-x-1">→</span>
          </span>

        </a>


        <a
          href="/rankings"
          class="group rounded-3xl border border-gray-200 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-gray-200/50"
        >

          <span class="text-3xl">🖥️</span>

          <h3 class="mt-6 text-2xl font-bold text-gray-950">
            Monitores
          </h3>

          <p class="mt-3 leading-relaxed text-gray-600">
            Descubre opciones para trabajar, estudiar, crear contenido
            o jugar.
          </p>

          <span class="mt-6 inline-flex items-center gap-2 font-semibold text-gray-950">
            Ver opciones
            <span class="transition group-hover:translate-x-1">→</span>
          </span>

        </a>


        <a
          href="/rankings"
          class="group rounded-3xl border border-gray-200 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-gray-200/50"
        >

          <span class="text-3xl">💻</span>

          <h3 class="mt-6 text-2xl font-bold text-gray-950">
            Laptops
          </h3>

          <p class="mt-3 leading-relaxed text-gray-600">
            Elige según rendimiento, portabilidad, batería y tipo
            de trabajo.
          </p>

          <span class="mt-6 inline-flex items-center gap-2 font-semibold text-gray-950">
            Ver opciones
            <span class="transition group-hover:translate-x-1">→</span>
          </span>

        </a>


        <a
          href="/rankings"
          class="group rounded-3xl border border-gray-200 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-gray-200/50"
        >

          <span class="text-3xl">⌚</span>

          <h3 class="mt-6 text-2xl font-bold text-gray-950">
            Smartwatches
          </h3>

          <p class="mt-3 leading-relaxed text-gray-600">
            Compara funciones, autonomía, sensores, compatibilidad
            y diseño.
          </p>

          <span class="mt-6 inline-flex items-center gap-2 font-semibold text-gray-950">
            Ver opciones
            <span class="transition group-hover:translate-x-1">→</span>
          </span>

        </a>


        <a
          href="/rankings"
          class="group rounded-3xl border border-gray-200 bg-white p-8 transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-gray-200/50"
        >

          <span class="text-3xl">🎮</span>

          <h3 class="mt-6 text-2xl font-bold text-gray-950">
            Gaming
          </h3>

          <p class="mt-3 leading-relaxed text-gray-600">
            Encuentra productos pensados para jugar sin pagar
            por características que no necesitas.
          </p>

          <span class="mt-6 inline-flex items-center gap-2 font-semibold text-gray-950">
            Ver opciones
            <span class="transition group-hover:translate-x-1">→</span>
          </span>

        </a>

      </div>

    </section>


    <!-- Rankings -->

    {
      technologyRankings.length > 0 && (

        <section class="mt-24">

          <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end">

            <div class="max-w-2xl">

              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
                Comparativas
              </p>

              <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 md:text-4xl">
                Rankings para comprar mejor
              </h2>

              <p class="mt-4 leading-relaxed text-gray-600">
                Nuestras comparativas reúnen diferentes opciones para
                que puedas conocer sus ventajas, desventajas y relación
                calidad-precio antes de comprar.
              </p>

            </div>

            <a
              href="/rankings"
              class="font-semibold text-gray-950 transition hover:text-blue-600"
            >
              Ver todos →
            </a>

          </div>


          <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">

            {
              technologyRankings.map((ranking) => (

                <a
                  href={`/rankings/${ranking.id}`}
                  class="group overflow-hidden rounded-3xl border border-gray-200 bg-white transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-gray-200/50"
                >

                  <div class="aspect-[16/9] overflow-hidden bg-gray-100">

                    <img
                      src={ranking.data.image}
                      alt={ranking.data.title}
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                      loading="lazy"
                    />

                  </div>


                  <div class="p-7">

                    <p class="text-sm font-semibold text-blue-600">
                      {ranking.data.category}
                    </p>

                    <h3 class="mt-3 text-xl font-bold tracking-tight text-gray-950">
                      {ranking.data.title}
                    </h3>

                    <p class="mt-3 line-clamp-3 leading-relaxed text-gray-600">
                      {ranking.data.description}
                    </p>

                    <span class="mt-6 inline-flex items-center gap-2 font-semibold text-gray-950">
                      Ver comparativa
                      <span class="transition group-hover:translate-x-1">→</span>
                    </span>

                  </div>

                </a>

              ))
            }

          </div>

        </section>

      )
    }


    <!-- Artículos -->

    {
      technologyArticles.length > 0 && (

        <section class="mt-24">

          <div class="max-w-2xl">

            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
              Antes de comprar
            </p>

            <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-950 md:text-4xl">
              Aprende a elegir
            </h2>

            <p class="mt-4 leading-relaxed text-gray-600">
              Entender la tecnología que estás comprando también es parte
              de hacer una buena compra.
            </p>

          </div>


          <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">

            {
              technologyArticles.map((article) => (

                <a
                  href={`/articulos/${article.id}`}
                  class="group rounded-3xl border border-gray-200 bg-white p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-gray-200/50"
                >

                  <p class="text-sm font-semibold text-blue-600">
                    {article.data.category}
                  </p>

                  <h3 class="mt-3 text-xl font-bold tracking-tight text-gray-950">
                    {article.data.title}
                  </h3>

                  <p class="mt-3 line-clamp-3 leading-relaxed text-gray-600">
                    {article.data.description}
                  </p>

                  <span class="mt-6 inline-flex items-center gap-2 font-semibold text-gray-950">
                    Leer artículo
                    <span class="transition group-hover:translate-x-1">→</span>
                  </span>

                </a>

              ))
            }

          </div>

        </section>

      )
    }


    <!-- Transparencia -->

    <section class="mt-24 rounded-3xl bg-gray-50 p-8 md:p-12">

      <div class="max-w-3xl">

        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
          Transparencia
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-950">
          Recomendaciones con una razón detrás
        </h2>

        <p class="mt-5 leading-relaxed text-gray-600">
          En Curioxin queremos que nuestras recomendaciones sean útiles
          incluso antes de realizar una compra. Por eso explicamos qué
          características importan, para quién tiene sentido cada producto
          y qué alternativas existen.
        </p>

        <p class="mt-4 leading-relaxed text-gray-600">
          Algunas recomendaciones pueden incluir enlaces comerciales.
          Si realizas una compra a través de uno de estos enlaces,
          Curioxin podría recibir una comisión sin que esto represente
          un costo adicional para ti.
        </p>

      </div>

    </section>


    <!-- CTA -->

    <section class="mt-20 rounded-3xl bg-gray-950 px-8 py-12 text-white md:px-12 md:py-14">

      <div class="max-w-3xl">

        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-400">
          Curioxin
        </p>

        <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-4xl">
          Tu próxima compra empieza aquí.
        </h2>

        <p class="mt-4 leading-relaxed text-gray-400">
          Compara, entiende las diferencias y decide con más información
          antes de gastar tu dinero.
        </p>

      </div>

    </section>

  </main>

</Layout>