---
import { formatDate } from "../utils/formatDate";

const {
  image = "/logo.png",
  category,
  title,
  description,
  slug,
  date,
  type = "article"
} = Astro.props;


const link =
type === "ranking"
? `/rankings/${slug}`
: `/articulos/${slug}`;

---

<a
href={link}
class="group block overflow-hidden rounded-3xl border border-gray-200 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-xl"
>


<article>


<div class="relative overflow-hidden">


<img

src={image}

alt={title}

loading="lazy"

decoding="async"

class="h-56 w-full object-cover transition duration-500 group-hover:scale-105"

/>




<div class="absolute left-5 top-5">

<span class="rounded-full bg-white px-4 py-2 text-sm font-semibold shadow">


{
type === "ranking"
? "🏆 Ranking"
: "📄 Artículo"
}


</span>


</div>


</div>






<div class="p-7">


<p class="text-sm font-semibold text-blue-600">

{category}

</p>




<h2 class="mt-3 text-2xl font-bold leading-tight">

{title}

</h2>





{
date && (

<p class="mt-3 text-sm text-gray-500">

📅 {formatDate(date)}

</p>

)
}





<p class="mt-4 leading-relaxed text-gray-600">

{description}

</p>





<div class="mt-6 font-semibold transition group-hover:text-blue-600">

{
type === "ranking"
? "Ver ranking →"
: "Leer artículo →"
}

</div>



</div>



</article>


</a>