---
const { icon, title, description } = Astro.props;
---

<div class="group rounded-3xl border border-gray-200 p-8 transition hover:-translate-y-1 hover:shadow-xl">

  <div class="mb-5 text-4xl">
    {icon}
  </div>


  <h3 class="mb-3 text-xl font-semibold">
    {title}
  </h3>


  <p class="text-gray-600">
    {description}
  </p>

</div>