---
import { getCollection } from "astro:content";
import { formatDate } from "../utils/formatDate";


const articles = await getCollection("articles");
const rankings = await getCollection("rankings");


const content = [

  ...articles.map(item => ({
    ...item,
    type: "article"
  })),

  ...rankings.map(item => ({
    ...item,
    type: "ranking"
  }))

]
.sort(
  (a,b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
)
.slice(0,6);

---


<section class="mx-auto max-w-7xl px-6 py-20">


<div class="mb-12 max-w-3xl">


<p class="text-sm font-semibold uppercase tracking-widest text-blue-600">
Curioxin
</p>


<h2 class="mt-3 text-4xl font-bold tracking-tight">
Últimas publicaciones
</h2>


<p class="mt-4 text-gray-600">
Explora los últimos análisis, comparativas y rankings publicados en Curioxin.
</p>


</div>





<div class="grid gap-8 md:grid-cols-3">



{
content.map(item => (


<a

href={
item.type === "ranking"
? `/rankings/${item.id}`
: `/articulos/${item.id}`
}

class="group overflow-hidden rounded-3xl border border-gray-200 bg-white transition hover:-translate-y-1 hover:shadow-xl"

>


<div class="relative overflow-hidden">


<img

src={item.data.image}

alt={item.data.title}

class="h-48 w-full object-cover transition duration-500 group-hover:scale-105"

/>



<div class="absolute left-5 top-5">


<span class="rounded-full bg-white px-4 py-2 text-sm font-semibold shadow">


{
item.type === "ranking"
? "🏆 Ranking"
: "📄 Artículo"
}


</span>


</div>


</div>





<div class="p-6">



<p class="text-sm font-semibold text-blue-600">
{item.data.category}
</p>




<h3 class="mt-3 text-xl font-bold leading-tight">
{item.data.title}
</h3>




<p class="mt-3 text-sm text-gray-500">
📅 {formatDate(item.data.date)}
</p>




<p class="mt-4 text-gray-600 line-clamp-3">
{item.data.description}
</p>





<div class="mt-5 font-semibold transition group-hover:text-blue-600">

{
item.type === "ranking"
? "Ver ranking →"
: "Leer artículo →"
}

</div>



</div>



</a>



))
}



</div>



</section>