---
import { getCollection } from "astro:content";

const articles = (await getCollection("articles"))
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() -
      new Date(a.data.date).getTime()
  );

const featured = articles[0];
---

<section
  style="margin-top: -30px;"
  class="relative overflow-hidden border-b border-gray-100 bg-white"
>

  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -right-40 -top-40 h-96 w-96 rounded-full bg-blue-100/40 blur-3xl"></div>
    <div class="absolute -left-40 bottom-0 h-80 w-80 rounded-full bg-gray-100/70 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 py-12 md:py-16">

    <div class="grid items-center gap-10 lg:grid-cols-[1fr_0.8fr]">

      <div>

        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600">
          Tecnología · IA · Productividad
        </p>

        <h1 class="mt-6 max-w-3xl text-5xl font-bold leading-[1.05] tracking-tight text-gray-950 md:text-6xl lg:text-7xl">
          Tecnología que vale la pena conocer.
        </h1>

        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-gray-600 md:text-xl">
          Analizamos tecnología, inteligencia artificial y herramientas digitales
          para ayudarte a entenderlas, compararlas y elegir mejor.
        </p>

        <div class="mt-9 flex flex-wrap gap-4">

          <a
            href="/articulos"
            class="rounded-full bg-black px-7 py-3.5 text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:bg-blue-600 hover:shadow-lg hover:shadow-blue-600/20"
          >
            Explorar artículos
          </a>

          <a
            href="/rankings"
            class="rounded-full border border-gray-200 px-7 py-3.5 text-sm font-semibold text-gray-800 transition-all duration-200 hover:-translate-y-0.5 hover:border-gray-300 hover:bg-gray-50"
          >
            Ver rankings
          </a>

        </div>

      </div>

      {
        featured && (
          <a
            href={`/articulos/${featured.id}`}
            class="group block max-w-lg lg:ml-auto"
          >

            <article class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">

              <div class="relative aspect-[16/9] overflow-hidden bg-gray-100">

                <img
                  src={featured.data.image}
                  alt={featured.data.title}
                  loading="eager"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />

                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/5 to-transparent"></div>

                <div class="absolute bottom-4 left-4">

                  <span class="rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-gray-900 backdrop-blur">
                    {featured.data.category}
                  </span>

                </div>

              </div>

              <div class="p-5">

                <p class="text-[11px] font-semibold uppercase tracking-widest text-gray-400">
                  Artículo destacado
                </p>

                <h2 class="mt-2 text-xl font-bold leading-tight text-gray-950 md:text-2xl">
                  {featured.data.title}
                </h2>

                <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-gray-600">
                  {featured.data.description}
                </p>

                <div class="mt-4 flex items-center justify-between">

                  <span class="text-sm font-semibold text-blue-600 transition group-hover:text-blue-700">
                    Leer artículo
                  </span>

                  <span class="text-lg transition-transform duration-200 group-hover:translate-x-1">
                    →
                  </span>

                </div>

              </div>

            </article>

          </a>
        )
      }

    </div>

  </div>

</section>