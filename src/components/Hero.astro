---
import { getCollection } from "astro:content";


const articles = (await getCollection("articles"))
.sort(
  (a,b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
);


const featured = articles[0];

---

<section class="mx-auto max-w-7xl px-6 py-24">


<div class="grid items-center gap-14 md:grid-cols-2">





<div>


<span class="inline-flex rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-600">

Tecnología · IA · Productividad

</span>





<h1 class="mt-6 text-5xl font-bold leading-tight tracking-tight md:text-6xl">

Analizamos la tecnología para ayudarte a elegir mejor

</h1>





<p class="mt-6 max-w-xl text-lg leading-relaxed text-gray-600">

En Curioxin investigamos herramientas digitales,
inteligencia artificial y productos tecnológicos para crear
comparativas, rankings y análisis que facilitan tus decisiones.

</p>







<div class="mt-8 flex flex-wrap gap-4">


<a

href="/rankings"

class="rounded-full bg-black px-7 py-3 font-semibold text-white transition hover:-translate-y-1 hover:bg-blue-600"

>

Explorar rankings

</a>





<a

href="/articulos"

class="rounded-full border border-gray-200 px-7 py-3 font-semibold transition hover:-translate-y-1 hover:border-black"

>

Leer artículos

</a>


</div>






</div>








<div class="relative">



<div class="rounded-3xl border border-gray-200 bg-gray-50 p-8 shadow-sm">





<div class="rounded-2xl bg-white p-6 shadow-sm">


<p class="text-sm font-semibold text-blue-600">
Curioxin
</p>



<h2 class="mt-3 text-2xl font-bold">
Tecnología explicada de forma simple
</h2>



<p class="mt-3 text-gray-600">
Descubre herramientas, comparativas y rankings para encontrar mejores opciones.
</p>




<div class="mt-6 grid grid-cols-2 gap-4">


<div class="rounded-xl bg-gray-50 p-4">

<p class="text-2xl">
🏆
</p>

<p class="mt-2 text-sm font-semibold">
Rankings
</p>

</div>





<div class="rounded-xl bg-gray-50 p-4">

<p class="text-2xl">
🤖
</p>

<p class="mt-2 text-sm font-semibold">
Inteligencia Artificial
</p>

</div>


</div>


</div>



</div>


</div>




</div>


</section>