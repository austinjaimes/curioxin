---
const {
  position,
  name,
  score
} = Astro.props;


const medals = {
  1: "🥇",
  2: "🥈",
  3: "🥉"
};
---


<div class="my-8 rounded-3xl border p-6">

<div class="flex items-center justify-between">


<h2 class="text-2xl font-bold">

{medals[position] || "🏆"}

#{position} {name}

</h2>



<span class="font-bold text-blue-600">

{score}/10

</span>


</div>


<div class="mt-4 text-gray-600">

<slot />

</div>


</div>